      "megalo": "-- Three Way Slayer. Compile using faction-battlefront-template.json.\n-- The deployment service owns class purchases and native respawns; this\n-- script only pays out deployment points. The game ends on the normal\n-- Slayer score limit. Teams 0/1/2 are Flood/Covenant/UNSC.\n-- (Phase 2 is never set; the wrapper below matches the original script.)\n-- Options (indices are alphabetical): 0 points_per_kill, 1 points_per_tick,\n-- 2 tick_seconds. The control panel adjusts them.\nalias phase = global.number[0]\nalias flood_players = global.number[1]\nalias covenant_players = global.number[2]\nalias unsc_players = global.number[3]\nalias scratch = global.number[4]\nalias points = global.number[5]\nalias income = global.timer[1]\nalias kills = player.number[0]\n\non init: do\n    income = script_option[2]\nend\n\nif phase != 2 then\n    flood_players = 0\n    covenant_players = 0\n    unsc_players = 0\n    for each player do\n        if current_player.team == team[0] then flood_players += 1 end\n        if current_player.team == team[1] then covenant_players += 1 end\n        if current_player.team == team[2] then unsc_players += 1 end\n        -- Enemy kills count even when a projectile lands after our death.\n        -- This is a wallet, independent of the native team/scoreboard score.\n        scratch = current_player.get_kill_count()\n        scratch -= current_player.kills\n        if scratch > 0 then\n            scratch *= script_option[0]\n            points = current_player.get_deployment_points()\n            points += scratch\n            if points > 100000 then points = 100000 end\n            current_player.set_deployment_points(points)\n        end\n        current_player.kills = current_player.get_kill_count()\n    end\n    -- Income starts once at least two teams have players.\n    if phase == 0 then\n        scratch = 0\n        if flood_players > 0 then scratch += 1 end\n        if covenant_players > 0 then scratch += 1 end\n        if unsc_players > 0 then scratch += 1 end\n        if scratch >= 2 then\n            phase = 1\n            income.set_rate(-100%)\n        end\n    end\n    -- Shared income includes players waiting to deploy, but only during battle.\n    if phase == 1 and income.is_zero() then\n        for each player do\n            if current_player.team == team[0] or current_player.team == team[1] or current_player.team == team[2] then\n                points = current_player.get_deployment_points()\n                points += script_option[1]\n                if points > 100000 then points = 100000 end\n                current_player.set_deployment_points(points)\n            end\n        end\n        income = script_option[2]\n        income.set_rate(-100%)\n    end\n    script_widget[1].set_text(\"Enemy kills earn %n points. Every %n seconds, all teams earn %n.\", script_option[0], script_option[2], script_option[1])\n    script_widget[1].set_visibility(all_players, true)\nend\n",
